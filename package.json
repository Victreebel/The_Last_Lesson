{
  "name": "the-last-lesson",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "server:multiplayer": "tsx server/index.ts",
    "optimize:assets": "tsx tools/optimize-assets.ts",
    "write:service-worker": "tsx tools/write-service-worker.ts",
    "balance:report": "tsx tools/run-balance-playtest.ts",
    "build": "pnpm optimize:assets && tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && pnpm write:service-worker",
    "package:storefront": "VITE_BASE_PATH=./ pnpm build && mkdir -p release && (cd dist && zip -r -FS ../release/the-last-lesson-web.zip .) && pnpm verify:storefront",
    "verify:storefront": "tsx tools/verify-storefront-package.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm test && pnpm build && pnpm test:browser",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
